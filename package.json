{
  "name": "stl-time",
  "version": "0.2.0",
  "description": "Print time estimator for the FlashForge Adventurer 5M Pro",
  "main": "./out/main/index.js",
  "author": "Pau Avila",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/ipaud/stl-time#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ipaud/stl-time.git"
  },
  "bugs": {
    "url": "https://github.com/ipaud/stl-time/issues"
  },
  "keywords": [
    "3d-printing",
    "stl",
    "slicer",
    "orcaslicer",
    "flashforge",
    "adventurer-5m-pro",
    "print-time",
    "electron",
    "macos"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && npm run test && electron-vite build",
    "dist": "npm run build && electron-builder --mac --arm64 --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,yml,json}\" \"*.md\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,yml,json}\" \"*.md\" \".github/**/*.yml\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "lucide-react": "^1.37.0",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
